def ow3_fin(+esr: Hv.W64, +fault: Hv.W64, +hpfar: Hv.W64, +eh: U32, +el: U32, +h: Shim.Host, +nzcv: U32, +daif: U32, +sys: List<&2, I.Sr>, +mem: List<&2, I.Cell>, +s2: Hv.Tree<Bool>, +lh: U32, +ll: U32) -> {Shim.stepped(3, I.Run{ow3_3(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)}) == Shim.stepped.want(Hv.W64{eh, el}, Hv.W64{lh, ll}) : Maybe<&2, Shim.Stepped>}:
  match h:
    case Shim.Host{Hv.W64{+hx2h, +hx2l}, Hv.W64{+hx3h, +hx3l}, Hv.W64{+hx4h, +hx4l}, Hv.W64{+hx5h, +hx5l}, Hv.W64{+hx6h, +hx6l}, Hv.W64{+hx7h, +hx7l}, Hv.W64{+hx8h, +hx8l}, Hv.W64{+hx9h, +hx9l}, Hv.W64{+hx10h, +hx10l}, Hv.W64{+hx11h, +hx11l}, Hv.W64{+hx12h, +hx12l}, Hv.W64{+hx13h, +hx13l}, Hv.W64{+hx14h, +hx14l}, Hv.W64{+hx15h, +hx15l}, Hv.W64{+hx16h, +hx16l}, Hv.W64{+hx17h, +hx17l}, Hv.W64{+hx18h, +hx18l}, Hv.W64{+hx19h, +hx19l}, Hv.W64{+hx20h, +hx20l}, Hv.W64{+hx21h, +hx21l}, Hv.W64{+hx22h, +hx22l}, Hv.W64{+hx23h, +hx23l}, Hv.W64{+hx24h, +hx24l}, Hv.W64{+hx25h, +hx25l}, Hv.W64{+hx26h, +hx26l}, Hv.W64{+hx27h, +hx27l}, Hv.W64{+hx28h, +hx28l}, Hv.W64{+hx29h, +hx29l}, Hv.W64{+hx30h, +hx30l}}:
      {==}

def ow3_law(+esr: Hv.W64, +fault: Hv.W64, +hpfar: Hv.W64, +eh: U32, +el: U32, +h: Shim.Host, +nzcv: U32, +daif: U32, +sys: List<&2, I.Sr>, +mem: List<&2, I.Cell>, +s2: Hv.Tree<Bool>, +lh: U32, +ll: U32) -> {Shim.stepped(3, I.steps(18n, I.Run{Shim.decide_mid(Hv.W64{0, 1}, esr, fault, hpfar, Shim.area(3), h, nzcv, daif, sys, I.Cell{Shim.at(Shim.area(3), 264), Hv.W64{eh, el}} <> mem, s2, Hv.W64{lh, ll})})) == Shim.stepped.want(Hv.W64{eh, el}, Hv.W64{lh, ll}) : Maybe<&2, Shim.Stepped>}:
  Equal.trans(Maybe<&2, Shim.Stepped>, Shim.stepped(3, I.steps(18n, I.Run{Shim.decide_mid(Hv.W64{0, 1}, esr, fault, hpfar, Shim.area(3), h, nzcv, daif, sys, I.Cell{Shim.at(Shim.area(3), 264), Hv.W64{eh, el}} <> mem, s2, Hv.W64{lh, ll})})), Shim.stepped(3, I.Run{ow3_3(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)}), Shim.stepped.want(Hv.W64{eh, el}, Hv.W64{lh, ll}),
    Equal.cong(I.Out, Maybe<&2, Shim.Stepped>, o => Shim.stepped(3, o),
      I.steps(18n, I.Run{Shim.decide_mid(Hv.W64{0, 1}, esr, fault, hpfar, Shim.area(3), h, nzcv, daif, sys, I.Cell{Shim.at(Shim.area(3), 264), Hv.W64{eh, el}} <> mem, s2, Hv.W64{lh, ll})}), I.Run{ow3_3(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)}, ow3_r0(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)),
    ow3_fin(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll))

