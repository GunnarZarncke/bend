def ow3_r2(+esr: Hv.W64, +fault: Hv.W64, +hpfar: Hv.W64, +eh: U32, +el: U32, +h: Shim.Host, +nzcv: U32, +daif: U32, +sys: List<&2, I.Sr>, +mem: List<&2, I.Cell>, +s2: Hv.Tree<Bool>, +lh: U32, +ll: U32) -> {I.steps(2n, I.Run{ow3_2(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)}) == I.Run{ow3_3(esr, fault, hpfar, eh, el, h, nzcv, daif, sys, mem, s2, lh, ll)} : I.Out}:
